rules_version = '2';

// Reglas de seguridad de Salary 2.0.
// Cerradas desde el primer despliegue: cada usuario solo lee y escribe users/{uid}/...
// Para invitar a alguien: añade su email a invited() y publica las reglas.
// La migración usa el Admin SDK (service account), que no pasa por estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function invited() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'frantejeda1993@gmail.com'
        ];
    }

    function isOwner(uid) {
      return invited() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // La traza de la migración solo la escribe el script.
      match /meta/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /{collection}/{docId} {
        allow read, write: if isOwner(uid) && collection != 'meta';
      }
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
