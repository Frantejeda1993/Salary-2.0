rules_version = '2';

// Reglas de seguridad de Salary 2.0.
// Cerradas por defecto: cada usuario solo lee y escribe users/{uid}/...
//
// Acceso por invitación (1-nov-2026): la lista de invitados vive en Firestore
// (allowlist/{email}), no aquí, para no publicar emails en el repositorio. El
// administrador aprueba desde Ajustes → Solicitudes de acceso. El único email que figura
// aquí es el del administrador.
//
// La migración usa el Admin SDK (service account), que no pasa por estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return signedIn() && myEmail() == 'frantejeda1993@gmail.com';
    }

    function invited() {
      return signedIn()
        && (isAdmin() || exists(/databases/$(database)/documents/allowlist/$(myEmail())));
    }

    // Texto opcional con tamaño máximo (lo que un usuario escribe y otro ve).
    function shortText(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }

    function isOwner(uid) {
      return invited() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // La traza de la migración solo la escribe el script.
      match /meta/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /{collection}/{docId} {
        allow read, write: if isOwner(uid) && collection != 'meta';
      }
    }

    // Lista de invitados: solo la ve y la cambia el administrador.
    // El id es el email en minúsculas.
    match /allowlist/{email} {
      allow read, write: if isAdmin();
    }

    // Solicitudes de acceso. El id es el email (en minúsculas) de quien quiere entrar.
    // - Cualquiera con sesión de Google puede pedir acceso para sí mismo.
    // - Un usuario invitado puede pedirlo para otra persona (invitar).
    // - Las ve quien la pidió o la persona a la que se refiere; el administrador, todas.
    // - Solo el administrador las aprueba o rechaza.
    match /accessRequests/{email} {
      function validNew() {
        let d = request.resource.data;
        return d.email == email
          && email == email.lower()
          && d.status == 'pending'
          && d.requestedByUid == request.auth.uid
          && d.keys().hasOnly(['email', 'status', 'requestedByUid', 'requestedByEmail', 'requestedByName', 'createdAt', 'note'])
          && email.size() <= 254
          && shortText(d, 'requestedByName', 100) && shortText(d, 'requestedByEmail', 254)
          && shortText(d, 'note', 300) && shortText(d, 'createdAt', 40)
          && (email == myEmail() || invited());
      }
      allow create: if signedIn() && validNew();
      allow read: if signedIn()
        && (isAdmin() || resource.data.requestedByUid == request.auth.uid || email == myEmail());
      allow update, delete: if isAdmin();
    }

    // Cuentas compartidas (parejas de 2, ambos consienten). Fase 8b.
    // Estados: pending (invitación) → active (aceptada) | declined | cancelled; active → ended.
    // members[0] es quien invita; members[1] se añade al aceptar.
    match /pairs/{pairId} {
      function data() { return request.resource.data; }
      function changed() { return data().diff(resource.data).affectedKeys(); }
      function isMember() { return request.auth.uid in resource.data.members; }
      function isInvitee() {
        return resource.data.status == 'pending' && resource.data.invitedEmail == myEmail();
      }

      allow create: if invited()
        && data().members == [request.auth.uid]
        && data().status == 'pending'
        && data().invitedBy == request.auth.uid
        && data().invitedEmail == data().invitedEmail.lower()
        && data().invitedEmail != myEmail()
        && data().keys().hasOnly(['members', 'status', 'invitedBy', 'invitedEmail', 'names', 'emails', 'createdAt'])
        && data().names.keys().hasOnly([request.auth.uid])
        && data().emails.keys().hasOnly([request.auth.uid])
        && data().invitedEmail.size() <= 254
        && shortText(data().names, request.auth.uid, 100);

      allow read: if invited() && (isMember() || isInvitee());

      allow update: if invited() && (
        // La persona invitada acepta: entra como segundo miembro.
        (isInvitee()
          && data().status == 'active'
          && data().members == [resource.data.members[0], request.auth.uid]
          && changed().hasOnly(['status', 'members', 'names', 'emails', 'acceptedAt'])
          && data().names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
          && data().emails.diff(resource.data.emails).affectedKeys().hasOnly([request.auth.uid])
          && data().emails[request.auth.uid] == myEmail()
          && shortText(data().names, request.auth.uid, 100))
        // …o rechaza.
        || (isInvitee() && data().status == 'declined' && changed().hasOnly(['status', 'endedAt']))
        // Quien invitó la cancela mientras está pendiente.
        || (resource.data.status == 'pending' && resource.data.invitedBy == request.auth.uid
          && data().status == 'cancelled' && changed().hasOnly(['status', 'endedAt']))
        // Cualquiera de los dos deja de compartir.
        || (resource.data.status == 'active' && isMember()
          && data().status == 'ended' && changed().hasOnly(['status', 'endedAt', 'endedBy']))
      );

      allow delete: if false;

      // ---------------------------------------------------------------- Fase 8c
      // Gastos compartidos. Solo los ven los dos miembros; solo se escribe con la pareja activa
      // (salvo confirmar o rechazar un pago ya enviado). Cada uno guarda en users/{uid} lo suyo
      // (su categoría y su movimiento): aquí no hay datos de las cuentas de nadie.
      function pairData() { return get(/databases/$(database)/documents/pairs/$(pairId)).data; }
      function pairMember() { return invited() && request.auth.uid in pairData().members; }
      function activeMember() { return pairMember() && pairData().status == 'active'; }

      // Gasto compartido. Solo quien lo creó lo edita o lo borra (E6).
      match /shared/{sharedId} {
        function validShared(d) {
          return d.keys().hasOnly(['date', 'description', 'amount', 'paidBy', 'createdBy', 'split', 'categoryName', 'createdAt', 'updatedAt', 'updatedBy'])
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.description is string && d.description.size() <= 200
            && d.amount is number && d.amount > 0 && d.amount < 1000000
            && d.paidBy in pairData().members
            && shortText(d, 'categoryName', 100)
            && d.split.mode in ['equal', 'percent', 'income']
            && d.split.keys().hasOnly(['mode', 'percent']);
        }
        allow read: if pairMember();
        allow create: if activeMember()
          && request.resource.data.createdBy == request.auth.uid
          && validShared(request.resource.data);
        allow update: if activeMember()
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && validShared(request.resource.data);
        allow delete: if activeMember() && resource.data.createdBy == request.auth.uid;
      }

      // Pagos para saldar: los envía quien paga y los confirma (o rechaza) quien recibe (E6).
      match /settlements/{settlementId} {
        function st() { return request.resource.data; }
        function stChanged() { return st().diff(resource.data).affectedKeys(); }
        allow read: if pairMember();
        allow create: if activeMember()
          && st().keys().hasOnly(['date', 'amount', 'from', 'to', 'status', 'createdAt'])
          && st().from == request.auth.uid
          && st().to in pairData().members && st().to != request.auth.uid
          && st().status == 'pending'
          && st().amount is number && st().amount > 0
          && st().date is string && st().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        allow update: if pairMember() && resource.data.status == 'pending' && (
          (resource.data.to == request.auth.uid && st().status in ['confirmed', 'rejected']
            && stChanged().hasOnly(['status', 'decidedAt']))
          || (resource.data.from == request.auth.uid && st().status == 'cancelled'
            && stChanged().hasOnly(['status', 'decidedAt']))
        );
        allow delete: if false;
      }

      // Total cobrado por cada uno en un mes (reparto por ingresos). Cada uno escribe solo el suyo.
      match /incomes/{incomeId} {
        function inc() { return request.resource.data; }
        allow read: if pairMember();
        allow create, update: if activeMember()
          && inc().keys().hasOnly(['uid', 'month', 'total', 'updatedAt'])
          && inc().uid == request.auth.uid
          && inc().month is string && inc().month.matches('^[0-9]{4}-[0-9]{2}$')
          && incomeId == request.auth.uid + '_' + inc().month
          && inc().total is number;
        allow delete: if false;
      }
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
